{
  "name": "testing-stuff",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "client:dev": "npm run dev -w @mb/client",
    "client:build": "npm run build -w @mb/client"
  },
  "dependencies": {
    "@bsv/auth": "^0.0.1",
    "@bsv/sdk": "^2.0.13",
    "@bsv/wallet-helper": "^0.0.6",
    "@bsv/wallet-toolbox-client": "^2.1.21",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "jose": "^6.1.0",
    "mongodb": "^6.20.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.2.2",
    "eslint": "^9",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
